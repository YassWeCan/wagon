# Copie ce fichier en ".env" puis remplis les valeurs. Ne JAMAIS commit le .env.

# --- BigQuery ---
GCP_PROJECT=ton-projet-gcp
ADHERENT_ID=12345
ADHERENT_NOM=Groupe Exemple
# Période analysée (3 mois). La période précédente (comparaison) est calculée automatiquement.
DATE_DEBUT=2026-07-01
DATE_FIN=2026-09-30

# --- Voix (ElevenLabs) — optionnel ---
ELEVENLABS_API_KEY=
# ID d'une voix française dans ta bibliothèque ElevenLabs
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
