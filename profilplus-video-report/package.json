{
  "name": "profilplus-video-report",
  "version": "1.0.0",
  "private": true,
  "description": "Rapport de stats animé (vidéo) par adhérent Profil Plus, alimenté par BigQuery",
  "type": "module",
  "scripts": {
    "demo-data": "node scripts/1-generer-donnees-demo.mjs",
    "fetch": "node scripts/2-extraire-bigquery.mjs",
    "voice": "node scripts/3-generer-voix.mjs",
    "studio": "remotion studio",
